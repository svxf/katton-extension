{
  "name": "katton-lang",
  "displayName": "katton language support",
  "description": "syntax highlighting, autocomplete, hover docs and token export/import for Katton (.kat) scripts!!",
  "version": "0.2.0",
  "publisher": "birb",
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [
    "onLanguage:katton"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "katton",
        "aliases": [
          "Katton",
          "katton"
        ],
        "extensions": [
          ".kat"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "katton",
        "scopeName": "source.katton",
        "path": "./syntaxes/katton.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "katton.exportToken",
        "title": "export import token",
        "category": "Katton"
      },
      {
        "command": "katton.importToken",
        "title": "import token",
        "category": "Katton"
      },
      {
        "command": "katton.showWiki",
        "title": "show wiki",
        "category": "Katton"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "katton.exportToken",
          "when": "editorLangId == katton",
          "group": "katton@1"
        }
      ],
      "commandPalette": [
        {
          "command": "katton.exportToken",
          "when": "editorLangId == katton"
        },
        {
          "command": "katton.importToken"
        },
        {
          "command": "katton.showWiki"
        }
      ]
    }
  }
}
